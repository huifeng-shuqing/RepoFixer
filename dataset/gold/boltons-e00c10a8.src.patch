+    def _bulk_discard(self, to_remove):
+        """Remove many items in a single O(n) pass.
+
+        Removing k scattered items via repeated :meth:`discard` triggers a
+        full O(n) compaction every ``_MAX_DEAD_INTERVALS`` removals, i.e.
