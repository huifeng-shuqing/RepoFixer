# DeepSeek 开放平台: https://platform.deepseek.com
# 复制本文件为 .env 并填入真实 key（.env 已被 gitignore，不会进仓库，也绝对不要发到聊天里）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 次级模型（摘要/复审路由用）：需接入另一家更便宜的模型才真正生效，
# 例如 GLM-4.5-Flash；未设置时回落到 DEEPSEEK_MODEL（路由不生效）
# DEEPSEEK_SMALL_MODEL=glm-4.5-flash
